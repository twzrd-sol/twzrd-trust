# twzrd-sentinel as a systemd user unit.
#
#   cp deploy/twzrd-sentinel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now twzrd-sentinel
#   journalctl --user -u twzrd-sentinel -f
#
# Set SENTINEL_HOME below: a checkout of twzrd-trust after
# `npm ci && npm run build:mandate`. systemd creates the state directory
# (~/.local/state/twzrd-sentinel, mode 0700); mandate.json, agent.json and the
# ledgers live there. As written it runs loopback (no wallet, no network).
# For live, add `--live --mandate %S/twzrd-sentinel/mandate.json` (a dry run)
# and, when a wallet is funded, `--pay-module <file>`.
#
# The control API listens on 127.0.0.1:4038. Pick another port if that one is
# taken; the unit will not start on a port in use.
[Unit]
Description=TWZRD sentinel: an autonomous buyer under a signed spend mandate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SENTINEL_HOME=%h/twzrd-trust
StateDirectory=twzrd-sentinel
StateDirectoryMode=0700
ExecStart=/usr/bin/env node ${SENTINEL_HOME}/examples/autonomous-sentinel/sentinel.mjs run --dir %S/twzrd-sentinel --interval 300 --control-port 4038
# SIGTERM finishes the cycle in progress and releases the state-directory lock.
KillSignal=SIGTERM
TimeoutStopSec=150
Restart=on-failure
RestartSec=30
# 2: a mandate the agent will not start under. 3: the mandate expired. Neither is fixed by a restart.
RestartPreventExitStatus=2 3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=default.target
