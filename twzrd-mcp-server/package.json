{
  "name": "twzrd-mcp-server",
  "version": "0.4.0",
  "description": "TWZRD Trust API MCP server with Solana x402 auto-pay (official @x402 SDK, spend-capped, preflight-gated).",
  "type": "module",
  "bin": {
    "twzrd-mcp-server": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/index.js",
    "examples/agent-drop-in.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/twzrd-trust.git",
    "directory": "twzrd-mcp-server"
  },
  "homepage": "https://intel.twzrd.xyz",
  "keywords": [
    "mcp",
    "x402",
    "solana",
    "agent",
    "trust",
    "twzrd",
    "reputation"
  ],
  "scripts": {
    "build": "tsc",
    "demo": "node examples/agent-drop-in.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "settle:proof": "node scripts/live-settle-proof.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana/kit": "^5.1.0",
    "@x402/core": "^2.17.0",
    "@x402/svm": "^2.17.0",
    "bs58": "^6.0.0",
    "twzrd-receipt-verifier": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
