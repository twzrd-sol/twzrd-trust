{
  "name": "@wzrd_sol/plugin-trustgate",
  "version": "0.3.0",
  "description": "x402 trust gate via the free TWZRD preflight. Buyer-side spend guard for elizaOS agents (canSpendSafely) AND a facilitator-side onBeforeSettle hook to screen every brokered settlement. No auth, no cost. BREAKING(0.3.0): fail-closed by default \u2014 pass failOpen:true to restore legacy allow-on-outage behavior.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./facilitator": {
      "types": "./dist/facilitator.d.ts",
      "import": "./dist/facilitator.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/gate.test.ts",
    "test:live": "TWZRD_LIVE_GATE=1 tsx test/gate.live.test.ts",
    "prepublishOnly": "tsc",
    "guard-demo": "tsx examples/first-installer.ts"
  },
  "keywords": [
    "elizaos",
    "plugin",
    "x402",
    "trust",
    "agent",
    "solana",
    "twzrd",
    "wash",
    "sybil",
    "spend-guard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/twzrd-trust.git",
    "directory": "packages/plugin-trustgate"
  },
  "homepage": "https://github.com/twzrd-sol/twzrd-trust/tree/main/plugin-trustgate#readme",
  "peerDependencies": {
    "@elizaos/core": ">=1.0.0"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  }
}
