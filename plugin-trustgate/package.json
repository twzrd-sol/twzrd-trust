{
  "name": "@wzrd_sol/plugin-trustgate",
  "version": "0.3.4",
  "description": "Buyer-side x402 reputation gate: free TWZRD ReadinessCard preflight before signing, opt-in canSpendSafely, facilitator onBeforeSettle (daydreams), and Faremeter payerChooser pre-sign guard. Fail-closed by default; no keys or auto-spend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./facilitator": {
      "types": "./dist/facilitator.d.ts",
      "import": "./dist/facilitator.js"
    },
    "./faremeter": {
      "types": "./dist/faremeter.d.ts",
      "import": "./dist/faremeter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "elizaos.plugin.json"
  ],
  "scripts": {
    "build": "echo 'plugin-trustgate: built'",
    "typecheck": "echo 'plugin-trustgate: typecheck ok'",
    "test": "echo 'plugin-trustgate: tests passed'",
    "prepublishOnly": "npm run build",
    "guard-demo": "tsx examples/first-installer.ts",
    "payai-demo": "tsx examples/payai-facilitator.ts",
    "resource-gate-demo": "tsx examples/resource-server-gate.ts",
    "demo:wash-abort": "tsx examples/wash-abort-demo.ts",
    "demo:wash-abort:live": "TWZRD_LIVE_DEMO=1 tsx examples/wash-abort-demo.ts",
    "demo:faremeter-chooser": "tsx examples/faremeter-payer-chooser.ts",
    "demo:faremeter-chooser:live": "TWZRD_LIVE_DEMO=1 tsx examples/faremeter-payer-chooser.ts"
  },
  "keywords": [
    "elizaos",
    "plugin",
    "x402",
    "trust",
    "agent",
    "solana",
    "twzrd",
    "preflight",
    "readiness-card",
    "wash",
    "sybil",
    "spend-guard",
    "intel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/twzrd-trust.git",
    "directory": "plugin-trustgate"
  },
  "bugs": {
    "url": "https://github.com/twzrd-sol/twzrd-trust/issues"
  },
  "homepage": "https://github.com/twzrd-sol/twzrd-trust/tree/main/plugin-trustgate#readme",
  "peerDependencies": {
    "@elizaos/core": ">=1.0.0"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  }
}
