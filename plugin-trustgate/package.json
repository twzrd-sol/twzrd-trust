{
  "name": "@wzrd_sol/plugin-trustgate",
  "version": "0.3.1",
  "description": "Buyer-side x402 trust gate for elizaOS: free TWZRD preflight (ReadinessCard allow/warn/block) via canSpendSafely + optional facilitator onBeforeSettle. Opt-in enforcement (does not auto-intercept signatures). Preflight-only in this package - pair with @wzrd_sol/eliza-plugin or twzrd-x402-gate for free merchant_card wash refuse. BREAKING(0.3.0): fail-closed by default; pass failOpen:true for legacy allow-on-outage.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./facilitator": {
      "types": "./dist/facilitator.d.ts",
      "import": "./dist/facilitator.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/gate.test.ts",
    "test:live": "TWZRD_LIVE_GATE=1 tsx test/gate.live.test.ts",
    "prepublishOnly": "tsc",
    "guard-demo": "tsx examples/first-installer.ts",
    "payai-demo": "tsx examples/payai-facilitator.ts",
    "resource-gate-demo": "tsx examples/resource-server-gate.ts"
  },
  "keywords": [
    "elizaos",
    "plugin",
    "x402",
    "trust",
    "agent",
    "solana",
    "twzrd",
    "preflight",
    "readiness-card",
    "wash",
    "sybil",
    "spend-guard",
    "marketplace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/twzrd-trust.git",
    "directory": "plugin-trustgate"
  },
  "bugs": {
    "url": "https://github.com/twzrd-sol/twzrd-trust/issues"
  },
  "homepage": "https://github.com/twzrd-sol/twzrd-trust/tree/main/plugin-trustgate#readme",
  "peerDependencies": {
    "@elizaos/core": ">=1.0.0"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  }
}
