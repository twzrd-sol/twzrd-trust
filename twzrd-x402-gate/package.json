    "@solana-program/token": "^0.9.0",
    "@types/node": "^20.11.0",
    "@x402/core": "^2.22.0",
    "@x402/fetch": "^2.22.0",
    "@x402/svm": "^2.22.0",
    "js-sha3": "^0.13.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0"
  }
}
