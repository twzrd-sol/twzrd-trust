    "@x402/core": ">=2.0.0",
    "@x402/fetch": ">=2.0.0",
    "@x402/svm": ">=2.0.0",
    "js-sha3": ">=0.8.0",
    "x402-solana": ">=3.0.0"
  },
  "peerDependenciesMeta": {
