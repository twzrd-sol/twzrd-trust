{
  "name": "@wzrd_sol/eliza-plugin",
  "version": "0.6.1",
  "description": "WZRD Agent Intel for ElizaOS. Default plugin registers intel actions only: free preflight ReadinessCard + merchant_card (wash_flagged refuse default), paid GET /v1/intel/trust (0.05 USDC) V6 receipt, offline verify. Legacy earn loop (infer/report/claim) is opt-in via createWzrdPlugin({ legacyEarnActions: true }).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.test.json",
    "test": "node --test dist/test/plugin-registration.intel.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@wzrd_sol/sdk": "^0.4.7",
    "bs58": "^5.0.0",
    "tweetnacl": "^1.0.3",
    "twzrd-x402-gate": "0.9.2"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elizaos/core": "^1.0.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "solana",
    "eliza",
    "elizaos",
    "wzrd",
    "intel",
    "x402",
    "trust",
    "receipt",
    "reputation",
    "preflight",
    "merchant_card",
    "wash",
    "marketplace",
    "legacy-earn",
    "ai-agent",
    "mcp"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/twzrd-trust.git",
    "directory": "eliza-plugin"
  },
  "bugs": {
    "url": "https://github.com/twzrd-sol/twzrd-trust/issues"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
